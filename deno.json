{
  "name": "@esolia/marquis",
  "version": "0.3.4",
  "exports": "./mod.ts",
  "tasks": {
    "check": "deno check mod.ts",
    "test": "deno test --allow-read",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "doc": "deno doc --html --output=docs/api mod.ts",
    "preflight": "deno fmt && deno check mod.ts && deno lint && deno test --allow-read",
    "publish:dry": "deno publish --dry-run --allow-slow-types"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": true,
    "exclude": ["docs/api", "docs-site/", "assets/**/*.svg"]
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    },
    "exclude": ["docs/api", "docs-site/"]
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["dom", "dom.iterable", "deno.ns"]
  },
  "publish": {
    "include": [
      "mod.ts",
      "index.ts",
      "ui/**/*.ts",
      "tokens/**/*.ts",
      "utils/**/*.ts",
      "assets/**/*.ts",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      ".git",
      ".github",
      ".claude",
      ".gitignore",
      ".DS_Store",
      "docs",
      "docs-site",
      "examples",
      "tests",
      "CLAUDE.md",
      "CLAUDE-GUIDE.md"
    ]
  }
}
